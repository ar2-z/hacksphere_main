APP_NAME=HackSphere
APP_VERSION=1.0.0
APP_ENV=production
DEBUG=false
SECRET_KEY=CHANGE-ME-to-a-random-64-char-string
JWT_SECRET_KEY=CHANGE-ME-to-a-different-random-64-char-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIVE_DAYS=7

# Server
HOST=0.0.0.0
PORT=8000

# Database (PostgreSQL inside Docker network)
DATABASE_URL=postgresql://hacksphere:CHANGE-ME@postgres:5432/hacksphere
DATABASE_POOL_SIZE=30
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false

# Redis (inside Docker network)
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_TTL=300

# Celery
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# File Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50

# Code Execution
CODE_EXECUTION_TIMEOUT=30
CODE_MEMORY_LIMIT_MB=256
CODE_CPU_LIMIT_PERCENT=50

# CORS
CORS_ORIGINS=["*"]

# Rate Limiting
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_PER_HOUR=5000

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# PostgreSQL (for docker-compose)
DB_PASSWORD=CHANGE-ME
REDIS_PASSWORD=changeme-redis
